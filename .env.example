# Reprodutibilidade
MACRO_SEED=42
MACRO_LOG_LEVEL=INFO

# Caminhos (relativos à raiz do repositório)
MACRO_DATA_RAW_DIR=data/raw
MACRO_DATA_PROCESSED_DIR=data/processed
MACRO_DATA_EXTERNAL_DIR=data/external
MACRO_ARTIFACTS_DIR=data/processed/artifacts
MACRO_DEMO_PARQUET_RELATIVE=data/demo/macro_ipca_selic.parquet

# Dashboard: força apenas dados demo (clone sem rede ou smoke tests).
# MACRO_DEMO_MODE=false

# MLflow — use prefixo MACRO_ para este projeto (tracking é passado pelo código ao cliente MLflow).
MACRO_MLFLOW_TRACKING_URI=file:./mlruns
MACRO_MLFLOW_EXPERIMENT_NAME=macroeconomia
# Nome registrado para o modelo pyfunc VAR estacionário (" " desabilita registry).
# MACRO_MLFLOW_REGISTERED_MODEL_NAME=macroeconomia_var_ipca_selic_stationary

# ARIMA (exemplo): vazio só grava artefactos + pyfunc no run, sem Model Registry.
# MACRO_MLFLOW_ARIMA_REGISTERED_MODEL_NAME=

# TTL de cache Streamlit (~12 horas por padrão).
# MACRO_DASHBOARD_CACHE_TTL_SECONDS=43200

# Commit exibido no Streamlit sidebar (opcional — CI/GitHub pode injetar).
# MACRO_GIT_COMMIT=

# Compatível com cliente MLflow em linha de comando legado:
# MLFLOW_TRACKING_URI=file:./mlruns

# Opcional: FRED (extra macroeconomia[data-sources])
# — nunca registre FRED_API_KEY em logs Prefect nem em runs MLflow públicos.
# FRED_API_KEY=
